# Server configuration. Copy to `.env` and adjust as needed.

# Where the API listens.
PRISM_HOST=127.0.0.1
PRISM_PORT=4319

# Database and asset storage live here.
PRISM_DATA_DIR=./data

# How many runs the worker executes in parallel.
PRISM_WORKER_CONCURRENCY=2

# How often a worker checks on an in-flight run, in milliseconds.
PRISM_POLL_INTERVAL_MS=1500

# Base URL used when building links to stored assets.
PRISM_PUBLIC_BASE_URL=http://127.0.0.1:4319

# Set to false to stop accepting new accounts.
PRISM_ALLOW_SIGNUP=true

# Optional remote image endpoint. When a key is present, the models that
# endpoint serves become available and can be picked on a generator node.
# PRISM_OPENAI_BASE_URL=https://api.openai.com/v1
# PRISM_OPENAI_API_KEY=
